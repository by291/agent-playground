SERVER_PORT=3000
AEGRA_URL=http://127.0.0.1:2026
APP_DATABASE_URL=postgresql://agent:agent@127.0.0.1:55432/agent_playground

# OTLP base URL. No Langfuse keys are sent to the browser.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Set the same random value in the Python and server environment files.
WORKFLOW_API_TOKEN=

# S3-compatible file storage; local Compose development values.
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=agent-skills
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=agent-playground
AWS_SECRET_ACCESS_KEY=agent-playground-local-s3
