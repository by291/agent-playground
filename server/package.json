{
  "name": "agent-playground-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --import ./observability/bootstrap.ts --watch server.ts",
    "check": "tsc --noEmit",
    "lint": "eslint '**/*.ts' --max-warnings 0",
    "test": "vitest run",
    "start": "node --env-file=.env --import tsx --import ./observability/bootstrap.ts server.ts",
    "test:watch": "vitest watch --project unit",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.58",
    "@ag-ui/core": "0.0.58",
    "@ag-ui/langgraph": "^0.0.43",
    "@hono/node-server": "^2.1.1",
    "@langchain/langgraph-sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.2"
  }
}
