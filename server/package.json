{
  "name": "agent-playground-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --import ./src/observability/bootstrap.ts --watch src/main.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src tests *.ts *.js --max-warnings 0",
    "test": "vitest run",
    "start": "node --env-file=.env --import tsx --import ./src/observability/bootstrap.ts src/main.ts",
    "test:watch": "vitest watch --project unit",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/langgraph": "^0.0.45",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@hono/node-server": "^2.1.5",
    "@langchain/langgraph-sdk": "^1.12.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  }
}
