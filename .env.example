# DeepSeek model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Context compaction (window defaults to the LangChain model profile)
CONTEXT_COMPACT_RATIO=0.8
# Set for custom models or endpoints without an accurate model profile.
# CONTEXT_WINDOW_TOKENS=1000000

# Aegra HTTP server
HOST=127.0.0.1
PORT=2026

# Local SQL workflow demonstration API (records submissions without execution)
SQL_DEMO_API_URL=http://127.0.0.1:2026/sql-demo

# Aegra state, checkpoints, and store (aegra schema)
DATABASE_URL=postgresql://aegra:aegra@127.0.0.1:55432/agent_playground

# Application output records (public schema)
APP_DATABASE_URL=postgresql://agent:agent@127.0.0.1:55432/agent_playground

# Redis broker
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://127.0.0.1:56379/0

# Optional tracing. make dev-observability supplies the local Collector settings.
OTEL_SERVICE_NAME=agent-playground-agent
OTEL_TARGETS=
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_PROMETHEUS_METRICS=false

# Set the same random value in the Python and server environment files.
WORKFLOW_API_TOKEN=

APP_API_URL=http://127.0.0.1:3000
REPORT_DEMO_API_URL=http://127.0.0.1:2026/report-demo

# Local Skill script execution (included in make infra-up)
SKILL_SANDBOX_URL=http://127.0.0.1:8080
SKILL_SANDBOX_API_KEY=agent-playground-local-sandbox
SKILL_SANDBOX_IMAGE=agent-playground-skill-runtime:local
SKILL_ALLOWED_HOSTS=httpbin.org
# Comma-separated environment variable names explicitly passed to scripts.
SKILL_SCRIPT_ENV=

# Shared knowledge embeddings (independent of the chat model)
RAG_EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_API_KEY=
# Maximum texts per embedding request. Qwen 3.7 supports 20; text-embedding-v3/v4 support 10.
RAG_EMBEDDING_BATCH_SIZE=20
# Optional: only set when supported by your embedding provider
RAG_EMBEDDING_DIMENSIONS=
# Maximum cosine distance accepted as retrieved evidence, between 0 and 2
RAG_MAX_DISTANCE=0.55
