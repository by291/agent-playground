# DeepSeek model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Aegra HTTP server
HOST=127.0.0.1
PORT=2026

