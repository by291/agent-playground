# DeepSeek model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Context compaction (window defaults to the LangChain model profile)
CONTEXT_COMPACT_RATIO=0.8
# Set for custom models or endpoints without an accurate model profile.
# CONTEXT_WINDOW_TOKENS=1000000

# Aegra HTTP server
HOST=127.0.0.1
PORT=2026

# Aegra state, checkpoints, and store (aegra schema)
DATABASE_URL=postgresql://aegra:aegra@127.0.0.1:55432/agent_playground

# Application output records (public schema)
APP_DATABASE_URL=postgresql://agent:agent@127.0.0.1:55432/agent_playground

# Redis broker
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://127.0.0.1:56379/0

# Optional tracing. make dev-observability supplies the local Collector settings.
OTEL_SERVICE_NAME=agent-playground-agent
OTEL_TARGETS=
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_PROMETHEUS_METRICS=false
